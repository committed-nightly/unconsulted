; A git config with nine things in it that git will never consult.
;
; `unconsulted` reads the config of a repository, not a file, because what it
; checks depends on the repository: whether a branch exists, whether a remote
; exists, which includes applied. examples/build.sh assembles a throwaway repo
; around this file so you can run the tool on it. The README walks through it.

[core]
	; One character wrong. git validates no key names, so this is silent
	; forever and you keep getting CRLF conversion you asked it to stop.
	autocrfl = input

	; Both of these are read. Only the second is ever returned.
	excludesFile = ~/.gitignore-old
	excludesFile = ~/.gitignore

[alias]
	; Dead on any machine with git-lfs installed, because `git-lfs` on PATH
	; makes `git lfs` a real command, and a real command beats an alias.
	lfs = !echo "my lfs"

	; Fine. Here so the check has something to stay quiet about.
	st = status -sb

[include]
	; Not there. git says nothing at all about a missing include.
	path = ./missing.config

	; There, but with nothing in it.
	path = ./empty.config

[includeIf "gitdir:~/definitely-not-a-real-directory/"]
	; The condition cannot match, because nothing is under that path.
	path = ./work.config

[remote "Origin"]
	; Section and variable names fold to lower case in git. Quoted
	; subsection names do not, so this is a second remote, not this one.
	url = https://example.invalid/wrong-case.git

[branch "deleted-last-spring"]
	; No such branch, so none of this is consulted -- until someone makes a
	; branch by that name, at which point it quietly starts applying.
	remote = upstraem
	merge = refs/heads/main
